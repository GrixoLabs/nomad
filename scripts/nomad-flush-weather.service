[Unit]
Description=Flush Nomad weather_cache table
After=network.target postgresql.service

[Service]
Type=oneshot
# Override NOMAD_HOME via: /etc/systemd/system/nomad-flush-weather.service.d/override.conf
Environment=NOMAD_HOME=/opt/nomad
WorkingDirectory=${NOMAD_HOME}
EnvironmentFile=-${NOMAD_HOME}/.env
ExecStart=${NOMAD_HOME}/.venv/bin/python ${NOMAD_HOME}/scripts/flush_weather_cache.py
Nice=10
