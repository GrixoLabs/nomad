[Unit]
Description=Sync Nomad map_plotter from device_signals / journals
After=network.target postgresql.service

[Service]
Type=oneshot
# Paths are rewritten by scripts/install-systemd-timers.sh
WorkingDirectory=/opt/nomad
EnvironmentFile=-/opt/nomad/.env
ExecStart=/opt/nomad/.venv/bin/python /opt/nomad/scripts/compute_map_plotter.py
Nice=10
