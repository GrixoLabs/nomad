DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=nomad
DATABASE_USER=nomad
DATABASE_PASSWORD=change-me

API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=*

# JWT — use a long random secret in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nomad <onboarding@resend.dev>

# Twilio SMS (your naming)
TWILIO_CLIENT_ID=
TWILIO_CLIENT_KEY=
TWILIO_FROM_NUMBER=

# Place / weather / tourism providers
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=NomadApp/1.0 (contact: ops@grixo.dev)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_URL=https://overpass-api.de/api/interpreter
EXTERNAL_HTTP_TIMEOUT_SECONDS=22

# Journal at-rest AES-GCM key (falls back to JWT_SECRET if unset)
JOURNAL_MASK_KEY=change-me-journal-mask-key

# Stadia Maps (Android history map tiles via GET /api/v1/map/config)
STADIA_API=
STADIA_STYLE=alidade_smooth
